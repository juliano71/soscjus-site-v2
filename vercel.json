{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/cidadao", "destination": "/usuario", "permanent": false },
    { "source": "/lawyer", "destination": "/advogado", "permanent": false }
  ],
  "headers": [
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
